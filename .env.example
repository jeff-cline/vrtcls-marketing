# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres
DATABASE_URL=postgres://vrtcls:vrtcls@localhost:5432/vrtcls

# Admin seed (first boot only — delete after)
ADMIN_EMAIL=jeff.cline@me.com
ADMIN_PASSWORD=set-a-strong-password-here

# Email sending (Resend)
RESEND_API_KEY=
EMAIL_FROM="vrtcls <hello@vrtcls.marketing>"
EMAIL_FROM_ADDRESS=hello@vrtcls.marketing
EMAIL_REPLY_TO=hello@vrtcls.marketing

# Physical mailing address (required by CAN-SPAM)
COMPANY_ADDRESS="vrtcls, PO Box XXX, City, ST 00000"

# WattData / HighIntentTargets — drives the auto-bake worker.
# Get a key from https://wattdata.ai/dashboard/api-keys (starts with watt_).
# Without this, the worker will mark every HITT as failed.
WATTDATA_API_KEY=
WATTDATA_ENDPOINT=https://api.wattdata.ai/v1/mcp/m2m

# Worker tuning (optional)
WORKER_POLL_MS=12000
WORKER_STALE_MIN=5
WORKER_FETCH_TIMEOUT_MS=30000
