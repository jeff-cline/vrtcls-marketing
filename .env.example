# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres
DATABASE_URL=postgres://vrtcls:vrtcls@localhost:5432/vrtcls

# Admin seed (first boot only — delete after)
ADMIN_EMAIL=jeff.cline@me.com
ADMIN_PASSWORD=set-a-strong-password-here

# Email sending (Resend)
RESEND_API_KEY=
EMAIL_FROM="vrtcls <hello@vrtcls.marketing>"
EMAIL_FROM_ADDRESS=hello@vrtcls.marketing
EMAIL_REPLY_TO=hello@vrtcls.marketing

# Physical mailing address (required by CAN-SPAM)
COMPANY_ADDRESS="vrtcls, PO Box XXX, City, ST 00000"

# =============================================================================
# HITT fulfillment mode
# =============================================================================
# Default: manual. Customer submits a HITT → admin gets pinged → admin opens
# /admin/hitt, copies the prompt into claude.ai (with the WattData connector),
# pastes the JSON result back, clicks Fulfill → customer gets emailed.
#
# To switch to fully-auto: get a WattData API key (starts with watt_) and set
# both AUTO_BAKE_ENABLED=true AND WATTDATA_API_KEY=watt_...  The worker
# process will then claim queued HITTs and ingest persons without you.
AUTO_BAKE_ENABLED=false

# Notification toggles (default ON)
ADMIN_NOTIFY_ON_HITT=true
CUSTOMER_NOTIFY_ON_FULFILL=true
# Defaults to ADMIN_EMAIL if blank
ADMIN_NOTIFY_EMAIL=

# WattData / HighIntentTargets — only used when AUTO_BAKE_ENABLED=true.
# Get a key from https://wattdata.ai/dashboard/api-keys (starts with watt_).
WATTDATA_API_KEY=
WATTDATA_ENDPOINT=https://api.wattdata.ai/v1/mcp/m2m

# Worker tuning (optional, only matters when AUTO_BAKE_ENABLED=true)
WORKER_POLL_MS=12000
WORKER_STALE_MIN=5
WORKER_FETCH_TIMEOUT_MS=30000
