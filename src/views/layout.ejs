<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>vrtcls.marketing — predictive intent outbound</title>
<link rel="icon" href="data:,">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>

<% if (typeof user !== 'undefined' && user && user.impersonating) { %>
<div class="bg-danger text-white py-2 small">
  <div class="container d-flex justify-content-between align-items-center">
    <div>👁 Impersonating <strong><%= user.email %></strong></div>
    <form method="post" action="/admin/end-impersonation" class="m-0">
      <button class="btn btn-sm btn-light fw-bold">End impersonation</button>
    </form>
  </div>
</div>
<% } %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
  <div class="container">
    <a class="navbar-brand fw-bold fs-4" href="/">vrtcls<span class="text-warning">.</span>marketing</a>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'admin' && !user.impersonating) { %>
          <a class="nav-link text-light" href="/admin">Admin</a>
          <a class="nav-link text-light" href="/admin/hitt">HITT Queue</a>
          <a class="nav-link text-light" href="/admin/users">Users</a>
          <a class="nav-link text-light" href="/admin/leaderboard">Leaderboard</a>
          <a class="nav-link text-light" href="/admin/reports">Reports</a>
          <a class="nav-link text-light" href="/admin/send">Send</a>
          <a class="nav-link text-light" href="/admin/templates">Templates</a>
          <a class="nav-link text-light" href="/admin/mailboxes">Mailboxes</a>
          <a class="nav-link text-light" href="/admin/personas">Personas</a>
          <a class="nav-link text-warning fw-bold" href="/admin/inbox">📥 Inbox</a>
        <% } else { %>
          <a class="nav-link text-light" href="/app">Dashboard</a>
          <a class="nav-link text-light" href="/app/hitts">My HITTs</a>
          <a class="nav-link text-light" href="/app/leads">Leads</a>
          <a class="nav-link text-light" href="/app/my-leads">Owned</a>
          <a class="nav-link text-light" href="/app/compose">Compose</a>
          <a class="nav-link text-light" href="/app/campaigns">Campaigns</a>
          <a class="nav-link text-light" href="/app/templates">My Templates</a>
          <a class="nav-link text-light" href="/app/mailboxes">Mailboxes</a>
        <% } %>
        <span class="badge bg-success">$<%= (user.credits_cents/100).toFixed(2) %></span>
        <span class="badge bg-info text-dark"><%= user.email_tokens %> tokens</span>
        <form method="post" action="/logout" class="d-inline m-0">
          <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
        </form>
      <% } else { %>
        <a class="nav-link text-light" href="/pricing">Pricing</a>
        <a class="nav-link text-light" href="/login">Log in</a>
        <a class="btn btn-warning btn-sm fw-bold" href="/signup">Get started</a>
      <% } %>
    </div>
  </div>
</nav>

<main class="container py-4">
<%- body %>
</main>

<footer class="container py-5 text-muted small border-top mt-5">
  <div class="d-flex justify-content-between">
    <div>© vrtcls.marketing — predictive intent outbound</div>
    <div>Built on billions of behavioral signals.</div>
  </div>
</footer>
</body>
</html>
