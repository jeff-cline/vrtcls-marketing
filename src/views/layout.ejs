<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>vrtcls.marketing</title>
<link rel="icon" href="data:,">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">vrtcls<span class="text-warning">.</span>marketing</a>
    <div class="d-flex align-items-center gap-3">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'admin') { %>
          <a class="nav-link text-light" href="/admin">Admin</a>
          <a class="nav-link text-light" href="/admin/users">Users</a>
          <a class="nav-link text-light" href="/admin/import">Import</a>
          <a class="nav-link text-light" href="/admin/templates">Templates</a>
        <% } else { %>
          <a class="nav-link text-light" href="/app">Dashboard</a>
          <a class="nav-link text-light" href="/app/keywords">Keywords</a>
          <a class="nav-link text-light" href="/app/leads">Buy Leads</a>
          <a class="nav-link text-light" href="/app/my-leads">My Leads</a>
          <a class="nav-link text-light" href="/app/compose">Compose</a>
          <a class="nav-link text-light" href="/app/campaigns">Campaigns</a>
        <% } %>
        <span class="badge bg-success">$<%= (user.credits_cents/100).toFixed(2) %></span>
        <span class="badge bg-info text-dark"><%= user.email_tokens %> tokens</span>
        <form method="post" action="/logout" class="d-inline m-0">
          <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
        </form>
      <% } else { %>
        <a class="nav-link text-light" href="/pricing">Pricing</a>
        <a class="nav-link text-light" href="/login">Log in</a>
        <a class="btn btn-warning btn-sm fw-bold" href="/signup">Get started</a>
      <% } %>
    </div>
  </div>
</nav>

<main class="container py-4">
<%- body %>
</main>

<footer class="container py-5 text-muted small border-top mt-5">
  <div class="d-flex justify-content-between">
    <div>© vrtcls.marketing</div>
    <div>Intent-based outbound that gets smarter every send.</div>
  </div>
</footer>
</body>
</html>
