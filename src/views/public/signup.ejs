<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="fw-bold mb-3">Create your account</h1>
    <p class="text-secondary">We'll drop $5.00 in your balance so you can test one fresh lead and five sends before committing a dime.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/signup" class="mt-3">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label">Password <span class="text-muted small">(8+ characters)</span></label>
        <input type="password" name="password" class="form-control" minlength="8" required>
      </div>
      <button class="btn btn-warning fw-bold w-100">Create account</button>
    </form>
    <div class="mt-3 text-muted small">Have an account? <a href="/login">Log in</a></div>
  </div>
</div>
