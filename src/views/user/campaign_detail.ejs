<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="fw-bold mb-1"><%= campaign.name %></h1>
    <div class="text-muted">
      <%= campaign.template_name %> ·
      <span class="badge bg-<%= campaign.status === 'sent' ? 'success' : (campaign.status === 'sending' ? 'primary' : (campaign.status === 'canceled' ? 'danger' : 'secondary')) %>"><%= campaign.status %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <% if (campaign.status === 'draft') { %>
      <form method="post" action="/app/campaigns/<%= campaign.id %>/launch" class="m-0">
        <button class="btn btn-warning fw-bold">Launch ▶</button>
      </form>
    <% } %>
    <% if (['draft','sending','paused'].includes(campaign.status)) { %>
      <form method="post" action="/app/campaigns/<%= campaign.id %>/cancel" class="m-0"
            onsubmit="return confirm('Cancel queued sends? Already-sent emails are not undone.');">
        <button class="btn btn-outline-danger">Cancel</button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="p-3 border rounded bg-white">
      <div class="text-muted small">Total scheduled</div>
      <div class="display-6 fw-bold"><%= sends.length %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-3 border rounded bg-white">
      <div class="text-muted small">Clicks</div>
      <div class="display-6 fw-bold text-warning"><%= clicks %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-3 border rounded bg-white">
      <div class="text-muted small">Value per click</div>
      <div class="display-6 fw-bold">$<%= (valuePerClickCents/100).toFixed(2) %></div>
      <div class="small text-muted">
        $<%= (campaign.customer_ltv_cents/100).toFixed(0) %> LTV × <%= campaign.value_multiplier_pct %>%
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="p-3 border rounded bg-white">
      <div class="text-muted small">Estimated value</div>
      <div class="display-6 fw-bold text-success">$<%= (estValueCents/100).toFixed(2) %></div>
    </div>
  </div>
</div>

<% if (campaign.cta_label || campaign.cta_url) { %>
  <div class="alert alert-light border small mb-4">
    <strong>CTA:</strong> &ldquo;<%= campaign.cta_label %>&rdquo; →
    <code><%= campaign.cta_url %></code>
  </div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="bg-white border rounded p-3">
      <h3 class="h6 fw-bold">Per persona</h3>
      <table class="table table-sm mb-0">
        <thead><tr><th>Persona</th><th class="text-end">Total</th><th class="text-end">Sent</th><th class="text-end">Queued</th></tr></thead>
        <tbody>
          <% byPersona.forEach(function(r) { %>
            <tr>
              <td><%= r.persona %></td>
              <td class="text-end"><%= r.total %></td>
              <td class="text-end text-success"><%= r.sent %></td>
              <td class="text-end text-secondary"><%= r.queued %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="bg-white border rounded p-3">
      <h3 class="h6 fw-bold">Per day</h3>
      <table class="table table-sm mb-0">
        <thead><tr><th>Day</th><th class="text-end">Sends</th></tr></thead>
        <tbody>
          <% byDay.forEach(function(d) { %>
            <tr><td><%= new Date(d.day).toLocaleDateString() %></td><td class="text-end fw-bold"><%= d.total %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<h3 class="h6 fw-bold">Schedule (<%= sends.length %> rows)</h3>
<div class="border rounded bg-white" style="max-height:560px;overflow:auto;">
  <table class="table table-sm mb-0 align-middle">
    <thead class="table-light sticky-top">
      <tr><th>Scheduled</th><th>Persona</th><th>Mailbox</th><th>Recipient</th><th>Status</th><th>Opened</th><th class="text-end">Clicks</th></tr>
    </thead>
    <tbody>
      <% sends.forEach(function(s) { %>
        <tr>
          <td class="small"><%= s.scheduled_for ? new Date(s.scheduled_for).toLocaleString() : '—' %></td>
          <td><%= s.persona_name || '—' %></td>
          <td class="text-muted small"><%= s.mailbox_label || '—' %></td>
          <td><%= s.first_name || '' %> <%= s.last_name || '' %><div class="text-muted small"><%= s.email %></div></td>
          <td><span class="badge bg-<%= s.status === 'sent' ? 'success' : (s.status === 'failed' ? 'danger' : (s.status === 'queued' ? 'secondary' : 'dark')) %>"><%= s.status %></span></td>
          <td><%= s.opened_at ? '✓' : '' %></td>
          <td class="text-end fw-bold"><%= s.click_count %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
