<section class="bake-stage py-5 text-center text-light position-relative overflow-hidden">
  <div class="bake-bg"></div>
  <canvas id="bake-rain" class="bake-rain"></canvas>
  <div class="position-relative" style="z-index:3;">
    <div class="badge bg-warning text-dark fs-6 mb-3">HITT IN PROGRESS — DO NOT LEAVE THIS PAGE</div>
    <h1 class="display-3 fw-bold mb-2">BAKING<span class="bake-dots"><span>.</span><span>.</span><span>.</span></span></h1>
    <p class="lead mb-0">"<%= hitt.prompt %>"</p>
    <% if (hitt.city || hitt.state) { %>
      <p class="text-warning mb-0"><%= hitt.city %><%= hitt.state ? ', '+hitt.state : '' %> · <%= hitt.radius_miles %> mi · up to <%= hitt.audience_limit %> people</p>
    <% } %>
  </div>
</section>

<section class="bake-reel position-relative overflow-hidden mb-4">
  <div class="bake-reel-fade-l"></div>
  <div class="bake-reel-fade-r"></div>
  <div id="bake-reel-track" class="bake-reel-track"></div>
</section>

<section class="bake-meter bg-dark text-light p-4 rounded mb-4 position-relative overflow-hidden">
  <div class="bake-bar"></div>
  <div class="position-relative">
    <div class="row text-center g-3">
      <div class="col-md-3"><div class="bake-step" data-min="0"><div class="num">①</div>Parsing intent</div></div>
      <div class="col-md-3"><div class="bake-step" data-min="20"><div class="num">②</div>Cluster matching</div></div>
      <div class="col-md-3"><div class="bake-step" data-min="50"><div class="num">③</div>Pulling persons</div></div>
      <div class="col-md-3"><div class="bake-step" data-min="80"><div class="num">④</div>Verifying contacts</div></div>
    </div>
  </div>
</section>

<section class="bg-white border rounded p-4 mb-4">
  <h3 class="h5 fw-bold mb-3">What's happening right now</h3>
  <ul id="bake-log" class="bake-log mb-0"></ul>
</section>

<section class="text-center text-muted small">
  Most HITTs bake in 30–90 seconds. Leave the tab open — we'll redirect you the moment your leads are ready.<br>
  Status: <span id="bake-status" class="fw-bold text-warning"><%= hitt.status %></span>
</section>

<script>
window.__HITT__ = {
  id: <%- JSON.stringify(hitt.id) %>,
  startedAt: <%- JSON.stringify(hitt.created_at) %>,
  city: <%- JSON.stringify(hitt.city || '') %>,
  state: <%- JSON.stringify(hitt.state || '') %>,
  radius: <%- JSON.stringify(hitt.radius_miles) %>,
  prompt: <%- JSON.stringify(hitt.prompt || '') %>
};
</script>
<script>
(function () {
  const H = window.__HITT__;
  const startedAt = new Date(H.startedAt).getTime();
  const log = document.getElementById('bake-log');
  const statusEl = document.getElementById('bake-status');

  const messages = [
    'Translating intent prompt into cluster expression…',
    'Cross-referencing 100M+ behavioral signals…',
    'Filtering by geo (' + (H.city || 'national') + ', ' + H.radius + ' mi)…',
    'Resolving identities to verified emails…',
    'Scoring intent freshness…',
    'Removing DNC and bounced records…',
    'Compiling final HITT audience…',
    'Cross-tagging against existing intent clusters…',
    'Validating phone + address coverage…',
    'Locking pricing tiers by lead age…',
    'Almost there — preparing your dashboard…'
  ];
  let i = 0;
  function pushLine() {
    const li = document.createElement('li');
    li.textContent = messages[i % messages.length];
    log.prepend(li);
    while (log.children.length > 8) log.removeChild(log.lastChild);
    i++;
  }
  pushLine();
  setInterval(pushLine, 3500);

  function updateBar() {
    const elapsed = (Date.now() - startedAt) / 1000;
    const pct = Math.min(95, (elapsed / 90) * 100);
    document.querySelector('.bake-bar').style.width = pct + '%';
    document.querySelectorAll('.bake-step').forEach(function (el) {
      const m = Number(el.getAttribute('data-min'));
      el.classList.toggle('active', pct >= m);
    });
  }
  updateBar();
  setInterval(updateBar, 1000);

  async function poll() {
    try {
      const res = await fetch('/app/hitt/' + H.id + '/status', { headers: { 'accept': 'application/json' } });
      if (!res.ok) return;
      const data = await res.json();
      statusEl.textContent = data.status;
      if (data.status === 'complete') {
        document.querySelector('.bake-bar').style.width = '100%';
        statusEl.textContent = 'complete — ' + (data.result_count || 0) + ' leads ready';
        setTimeout(function () { window.location.href = '/app/leads?hitt_id=' + H.id; }, 600);
      } else if (data.status === 'failed') {
        statusEl.textContent = 'failed — please contact support';
      }
    } catch (_) {}
  }
  poll();
  setInterval(poll, 5000);

  /* ====== matrix-style code reel ====== */
  const canvas = document.getElementById('bake-rain');
  const ctx = canvas.getContext('2d');
  function size() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }
  size();
  window.addEventListener('resize', size);
  const charset = '01░▒▓█ABCDEF0123456789{}[]:;.,/\\|<>=+*#$@%&_~?!';
  const fontSize = 14;
  let columns = Math.floor(canvas.width / fontSize);
  let drops = new Array(columns).fill(0).map(() => Math.random() * -50);
  function rainTick() {
    if (Math.floor(canvas.width / fontSize) !== columns) {
      columns = Math.floor(canvas.width / fontSize);
      drops = new Array(columns).fill(0).map(() => Math.random() * -50);
    }
    ctx.fillStyle = 'rgba(10,10,12,0.18)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.font = fontSize + 'px ui-monospace, Menlo, monospace';
    for (let c = 0; c < columns; c++) {
      const ch = charset[Math.floor(Math.random() * charset.length)];
      const y = drops[c] * fontSize;
      ctx.fillStyle = Math.random() > 0.96 ? '#ffc107' : 'rgba(255,193,7,0.55)';
      ctx.fillText(ch, c * fontSize, y);
      if (y > canvas.height && Math.random() > 0.975) drops[c] = 0;
      drops[c]++;
    }
  }
  setInterval(rainTick, 60);

  /* ====== horizontal reel of fake JSON / signals ====== */
  const reel = document.getElementById('bake-reel-track');
  const fragments = [
    '{"person_id":"p_8a3f12","intent":0.94,"sig":"search:term_life"}',
    'cluster.match("' + (H.prompt || 'intent') + '") => 0.88',
    'geo.within("' + (H.city || 'US') + '", ' + H.radius + 'mi) ✓',
    'fresh.window=24h scoring…',
    'identity.resolve(email|phone|name|address)',
    '{"email":"j***@e.com","tier":"24h","price_cents":500}',
    'dnc.filter(removed=2,431)',
    'compile.audience(target=' + (H.prompt || 'intent') + ')',
    'predictive.model.v9.2 → confidence 0.91',
    '{"sig":"page_view","domain":"compare-quotes.io","weight":0.74}',
    'rebalance(intent_freshness × geo_density)',
    'verify.phone(twilio_lookup) batch=200',
    'tag.synth(["' + ((H.prompt || '').split(' ')[0] || 'intent') + '","high_intent"])',
    'lock.tier(<=24h=$5.00, <=7d=$2.50, <=30d=$1.00, archive=$0.50)',
    'audience.size=' + (Math.floor(Math.random() * 400) + 200),
    'signals.scanned=' + (Math.floor(Math.random() * 9) + 1) + '.' + Math.floor(Math.random() * 9) + 'B'
  ];
  function reelLine() {
    if (reel.children.length > 40) reel.removeChild(reel.firstChild);
    const span = document.createElement('span');
    span.className = 'bake-reel-line';
    span.textContent = fragments[Math.floor(Math.random() * fragments.length)];
    reel.appendChild(span);
  }
  for (let k = 0; k < 14; k++) reelLine();
  setInterval(reelLine, 220);
})();
</script>
