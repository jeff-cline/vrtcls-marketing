<h1 class="fw-bold mb-3">Admin send</h1>
<p class="text-secondary">Send to a specific user's leads, or to every lead carrying a tag (across the database). One token per send.</p>

<form method="post" action="/admin/send" class="bg-white p-4 border rounded">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label fw-bold">Target user (optional)</label>
      <select name="target_user_id" class="form-select">
        <option value="">— Any user / use tag below —</option>
        <% users.forEach(function(u) { %>
          <option value="<%= u.id %>"><%= u.email %> (<%= u.lead_count %> leads)</option>
        <% }) %>
      </select>
      <div class="form-text">If selected, sends only to leads owned by this user.</div>
    </div>
    <div class="col-md-6">
      <label class="form-label fw-bold">Tag / keyword (optional)</label>
      <input name="tag" class="form-control" list="tag-list" placeholder="term_life, stem_cells, clicked:offer">
      <datalist id="tag-list">
        <% tags.forEach(function(t) { %>
          <option value="<%= t.tag %>"><%= t.tag %> (<%= t.n %>)</option>
        <% }) %>
      </datalist>
      <div class="form-text">If set, send to every lead carrying this tag in the main DB. If both fields set, intersects.</div>
    </div>
    <div class="col-md-6">
      <label class="form-label fw-bold">Template</label>
      <select name="template_id" class="form-select" required>
        <% templates.forEach(function(t) { %>
          <option value="<%= t.id %>"><%= t.name %> — "<%= t.subject %>"</option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label fw-bold">Campaign name</label>
      <input name="campaign_name" class="form-control" required maxlength="200" placeholder="Q2 push · stem cells">
    </div>
    <div class="col-12">
      <div class="form-check">
        <input type="checkbox" class="form-check-input" name="use_user_credits" id="use_user_credits">
        <label class="form-check-label" for="use_user_credits">Charge tokens to selected user (otherwise charge admin)</label>
      </div>
    </div>
  </div>
  <div class="mt-3 text-end">
    <button class="btn btn-warning fw-bold">Send</button>
  </div>
</form>
