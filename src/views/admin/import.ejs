<h1 class="fw-bold mb-1">Import leads</h1>
<p class="text-secondary">
  Drop an <strong>.xlsx</strong> file or paste a HighIntentTargets <code>find_persons</code> JSON payload.
  The xlsx parser looks at the first sheet whose columns include Full Name / Email / City etc.
  Multiple emails per row are accepted (semicolon or comma separated) — we use the first valid one.
</p>

<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-xlsx">Spreadsheet (.xlsx)</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-json">JSON paste</button></li>
</ul>

<div class="tab-content">
  <div class="tab-pane fade show active" id="tab-xlsx">
    <form method="post" action="/admin/import/xlsx" enctype="multipart/form-data" class="bg-white p-4 border rounded">
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Tag (applied to every row)</label>
          <input name="tag" class="form-control" placeholder="stem_cells, term_life, tier_1_2, etc.">
        </div>
        <div class="col-md-6">
          <label class="form-label">Audience label (optional)</label>
          <input name="label" class="form-control" placeholder="Stemcell Tier 1+2 — Apr 2026">
        </div>
      </div>

      <div id="dropzone"
           style="border:2px dashed #ffc107;border-radius:8px;padding:40px;text-align:center;background:#fffdf3;cursor:pointer;">
        <div style="font-size:42px;line-height:1;">⬆</div>
        <div class="fw-bold mt-2">Drop .xlsx here or click to choose</div>
        <div class="text-muted small">Sheet names like "Tier 1 &amp; 2 Contacts" are auto-detected.</div>
        <div id="dz-filename" class="mt-2 small text-success fw-bold"></div>
        <input type="file" name="file" id="dz-input" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" style="display:none;" required>
      </div>

      <div class="mt-3">
        <button class="btn btn-warning fw-bold">Import</button>
      </div>
    </form>
  </div>

  <div class="tab-pane fade" id="tab-json">
    <form method="post" action="/admin/import" class="bg-white p-4 border rounded">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Keyword tag</label>
          <input name="tag" class="form-control" placeholder="term_life, stem_cells, etc.">
          <div class="form-text">This tag is written to every lead in the import.</div>
        </div>
        <div class="col-md-3">
          <label class="form-label">Workflow ID (optional)</label>
          <input name="workflow_id" class="form-control">
        </div>
        <div class="col-md-3">
          <label class="form-label">Tool trace ID (optional)</label>
          <input name="tool_trace_id" class="form-control">
        </div>
      </div>
      <div class="mt-3">
        <label class="form-label">Persons JSON</label>
        <textarea name="persons" class="form-control font-monospace" rows="14" placeholder='[{"person_id":"abc","email":"a@b.com","first_name":"Sam",...}]'></textarea>
        <div class="form-text">Expected: a JSON array on <code>persons</code> — or wrap your payload as <code>{"persons": [...]}</code>.</div>
      </div>
      <div class="mt-3">
        <button class="btn btn-warning fw-bold">Import</button>
      </div>
    </form>
  </div>
</div>

<% if (result) { %>
  <% if (result.error) { %>
    <div class="alert alert-danger mt-4"><%= result.error %></div>
  <% } else { %>
    <div class="alert alert-success mt-4">
      <strong>Imported audience #<%= result.audienceId %></strong>
      — <%= result.inserted %> new, <%= result.updated || 0 %> updated, <%= result.total %> total
      <% if (result.sourceRows) { %> · <%= result.sourceRows %> rows parsed from spreadsheet<% } %>.
      Next: head to <a href="/admin/send">Send</a> to compose a campaign against this audience.
    </div>
  <% } %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
  var dz = document.getElementById('dropzone');
  var input = document.getElementById('dz-input');
  var label = document.getElementById('dz-filename');
  if (!dz || !input) return;
  function show(name) { label.textContent = '✓ ' + name; }
  dz.addEventListener('click', function(){ input.click(); });
  input.addEventListener('change', function(){
    if (input.files && input.files[0]) show(input.files[0].name);
  });
  ['dragenter','dragover'].forEach(function(ev){
    dz.addEventListener(ev, function(e){ e.preventDefault(); dz.style.background = '#fff5b5'; });
  });
  ['dragleave','drop'].forEach(function(ev){
    dz.addEventListener(ev, function(e){ e.preventDefault(); dz.style.background = '#fffdf3'; });
  });
  dz.addEventListener('drop', function(e){
    if (e.dataTransfer.files && e.dataTransfer.files[0]) {
      input.files = e.dataTransfer.files;
      show(input.files[0].name);
    }
  });

  var jsonForm = document.querySelector('#tab-json form');
  if (jsonForm) jsonForm.addEventListener('submit', function(){
    var t = this.persons;
    try { var v = JSON.parse(t.value); if (Array.isArray(v)) t.value = JSON.stringify({persons: v}); } catch(_) {}
  });
})();
</script>
