<h1 class="fw-bold mb-3">Email templates (global library)</h1>
<p class="text-secondary">
  Edit subject + HTML for the global starter library. Each user can fork these into their own private versions at <code>/app/templates</code>.
  <br>Lead vars: <code>{{first_name}}</code>, <code>{{city}}</code>, <code>{{state}}</code>, <code>{{zip}}</code>, <code>{{topic}}</code>.
  Persona vars (filled from the sending mailbox's persona): <code>{{persona_name}}</code>, <code>{{persona_title}}</code>, <code>{{persona_signature}}</code>.
  Mark clickable CTA links with <code>data-link-key="slug"</code> — those keys become tags when a lead clicks.
</p>

<% if (flash) { %>
  <div class="alert alert-info py-2 small"><%= flash %><% if (flashErr) { %> — <%= flashErr %><% } %></div>
<% } %>

<% templates.forEach(function(t) { %>
  <details class="bg-white p-3 border rounded mb-3" <%= t.id === 1 ? 'open' : '' %>>
    <summary class="fw-bold fs-5"><%= t.name %> <span class="text-muted small">(<%= t.slug %>)</span></summary>

    <form method="post" action="/admin/templates/<%= t.id %>" class="mt-3">
      <div class="mb-2">
        <label class="form-label">Name</label>
        <input name="name" class="form-control" value="<%= t.name %>" required>
      </div>
      <div class="mb-2">
        <label class="form-label">Subject</label>
        <input name="subject" class="form-control" value="<%= t.subject %>" required>
      </div>
      <div class="mb-2">
        <label class="form-label">HTML body</label>
        <textarea name="body_html" class="form-control font-monospace" rows="12"><%= t.body_html %></textarea>
      </div>
      <button class="btn btn-warning fw-bold">Save</button>
    </form>

    <hr>
    <form method="post" action="/admin/templates/<%= t.id %>/send-test" class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="form-label small">Send test to</label>
        <input class="form-control" name="recipient" value="<%= user.email %>" required>
      </div>
      <div class="col-md-5">
        <label class="form-label small">From mailbox</label>
        <select class="form-select" name="mailbox_id">
          <option value="">— first available / Resend fallback —</option>
          <% mailboxes.forEach((m) => { %>
            <option value="<%= m.id %>"><%= m.label %><% if (m.persona_name) { %> · <%= m.persona_name %><% } %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-success w-100">Send test</button>
      </div>
    </form>
  </details>
<% }) %>
