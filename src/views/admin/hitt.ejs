<h1 class="fw-bold mb-3">HITT Queue</h1>
<p class="text-secondary">Pending HITT requests across all users. Fulfill by pasting the MCP <code>find_persons</code> JSON output.</p>

<% hitts.forEach(function(h) { %>
  <details class="bg-white p-3 border rounded mb-3" <%= (h.status === 'baking' || h.status === 'queued') ? 'open' : '' %>>
    <summary>
      <span class="fw-bold fs-5"><%= h.label %></span>
      <span class="text-muted">— <%= h.user_email %></span>
      <span class="ms-2">
        <% if (h.status === 'baking' || h.status === 'queued') { %>
          <span class="badge bg-warning text-dark"><span class="hitt-pulse">●</span> <%= h.status %></span>
        <% } else if (h.status === 'complete') { %>
          <span class="badge bg-success">complete · <%= h.result_count || 0 %></span>
        <% } else { %>
          <span class="badge bg-secondary"><%= h.status %></span>
        <% } %>
      </span>
      <span class="text-muted small ms-2"><%= new Date(h.created_at).toLocaleString() %></span>
    </summary>

    <div class="row mt-3">
      <div class="col-md-5">
        <div class="bg-light p-3 rounded">
          <div><strong>Prompt:</strong> <%= h.prompt %></div>
          <div class="mt-1"><strong>Geo:</strong> <%= h.city || '—' %><%= h.state ? ', '+h.state : '' %> · <%= h.radius_miles %> mi radius</div>
          <div><strong>Limit:</strong> <%= h.audience_limit %></div>
          <% if (h.audience_id) { %><div><strong>Audience:</strong> #<%= h.audience_id %> (<%= h.lead_count %> leads)</div><% } %>
        </div>
        <div class="bg-light p-3 rounded mt-2 small">
          <div class="fw-bold mb-1">Run in Claude Code:</div>
          <pre class="mb-0">Use HighIntentTargets MCP. build_cluster_expression for prompt:
"<%= h.prompt %>"
Then find_persons with that expression,
location <%= h.city || '<lat>' %>, radius <%= h.radius_miles %> miles,
audience_limit <%= h.audience_limit %>, format=json,
identifier_types=[email,phone,name,address].
Return the persons array.</pre>
        </div>
      </div>

      <div class="col-md-7">
        <% if (h.status !== 'complete' && h.status !== 'failed') { %>
          <form method="post" action="/admin/hitt/<%= h.id %>/fulfill">
            <label class="form-label fw-bold">Persons JSON</label>
            <textarea name="persons" class="form-control font-monospace" rows="10" placeholder='[{"person_id":"...","email":"...",...}] or {"persons":[...]}'></textarea>
            <div class="d-flex gap-2 mt-2">
              <button class="btn btn-warning fw-bold">Fulfill HITT</button>
              <button type="button" class="btn btn-outline-danger" onclick="this.closest('form').action='/admin/hitt/<%= h.id %>/fail'; this.closest('form').submit();">Mark failed</button>
            </div>
          </form>
        <% } else if (h.status === 'complete') { %>
          <div class="alert alert-success mb-0">Fulfilled · <%= h.result_count %> leads delivered.</div>
        <% } else { %>
          <div class="alert alert-warning mb-0">Failed. Notes: <%= h.notes || '—' %></div>
        <% } %>
      </div>
    </div>
  </details>
<% }) %>

<% if (!hitts.length) { %>
  <div class="alert alert-info">No HITT requests yet.</div>
<% } %>
